{
  "name": "bar-display",
  "version": "1.0.0",
  "description": "Werbe- und Infodisplay fuer die Bar auf der Planetenweide (Tarmac)",
  "productName": "Bar Display",
  "main": "main.js",
  "author": "Tarmac Festival",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/schedule.test.js",
    "vendor:ffmpeg": "node scripts/fetch-ffmpeg.js",
    "dist": "node scripts/fetch-ffmpeg.js && electron-builder --win nsis portable",
    "dist:linux": "node scripts/fetch-ffmpeg.js && electron-builder --linux AppImage deb tar.gz",
    "dist:all": "node scripts/fetch-ffmpeg.js && electron-builder --win nsis portable --linux AppImage deb tar.gz",
    "dist:linux-portable": "node scripts/fetch-ffmpeg.js && electron-builder --linux tar.gz",
    "dist:mac": "node scripts/fetch-ffmpeg.js && electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "de.planetenweide.bardisplay",
    "productName": "Bar Display",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "vendor/ffmpeg/win32-x64",
          "to": "ffmpeg"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Bar Display"
    },
    "portable": {
      "artifactName": "BarDisplay-portable-${version}.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "AudioVideo",
      "executableName": "bar-display",
      "maintainer": "Tarmac Festival <mn.beermann@gmail.com>",
      "synopsis": "Anzeige für die Bars des Tarmac Festivals",
      "description": "Werbeclips in Endlosschleife, dazwischen Timetable und Getränkepreise.",
      "desktop": {
        "entry": {
          "StartupWMClass": "Bar Display"
        }
      },
      "extraResources": [
        {
          "from": "vendor/ffmpeg/linux-x64",
          "to": "ffmpeg"
        }
      ]
    },
    "appImage": {
      "artifactName": "BarDisplay-${version}-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "bar-display_${version}_amd64.deb"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "extraResources": [
        {
          "from": "vendor/ffmpeg/darwin",
          "to": "ffmpeg"
        }
      ],
      "identity": null,
      "darkModeSupport": true
    },
    "dmg": {
      "artifactName": "BarDisplay-${version}-${arch}.dmg"
    }
  }
}
